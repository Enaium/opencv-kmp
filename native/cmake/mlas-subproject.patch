 set(MLAS_WASM        FALSE CACHE INTERNAL "" FORCE)
 
-if (CMAKE_SYSTEM_NAME STREQUAL "Emscripten")
+# On Apple the CMake host probe reports the build machine's architecture even
+# for native cross-arch builds (e.g. x86_64 target on an arm64 Mac), so use
+# the explicit CMAKE_OSX_ARCHITECTURES when present.
+if(APPLE AND DEFINED CMAKE_OSX_ARCHITECTURES)
+  if(CMAKE_OSX_ARCHITECTURES MATCHES "arm64|aarch64")
+    set(MLAS_ARM64 TRUE CACHE INTERNAL "" FORCE)
+  elseif(CMAKE_OSX_ARCHITECTURES MATCHES "x86_64")
+    set(MLAS_X86_64 TRUE CACHE INTERNAL "" FORCE)
+  endif()
+elseif (CMAKE_SYSTEM_NAME STREQUAL "Emscripten")
   set(MLAS_WASM TRUE CACHE INTERNAL "" FORCE)
 elseif(CMAKE_SYSTEM_PROCESSOR MATCHES "^arm64.*")
   set(MLAS_ARM64 TRUE CACHE INTERNAL "" FORCE)
@@ -238,7 +247,7 @@ add_library(opencv_dnn_mlas OBJECT ${mlas_common_srcs} ${mlas_platform_srcs})
