package = cvk
headers = opencv_kmp.h
headerFilter = opencv_kmp.h opencv_kmp_coretypes.h opencv_kmp_core.h opencv_kmp_imgproc.h opencv_kmp_imgproc2.h opencv_kmp_imgcodecs.h opencv_kmp_features.h opencv_kmp_features2.h opencv_kmp_geometry.h opencv_kmp_calib.h opencv_kmp_photo.h opencv_kmp_video.h opencv_kmp_video2.h opencv_kmp_videoio.h opencv_kmp_objdetect.h opencv_kmp_objdetect2.h opencv_kmp_stereo.h opencv_kmp_ptcloud.h opencv_kmp_dnn.h opencv_kmp_dnn2.h

# Every OpenCV/3rdparty static archive is embedded into the klib via
# separate -libraryPath/-staticLibrary options from build.gradle.kts.
# Consumers additionally need these system libraries. The GNU C++ runtime
# itself travels inside the klib (libstdc++_linux_arm64/mingw_x64), so
# -lstdc++ would only create duplicate-symbol clashes here.
linkerOpts.linux = -lm -ldl -lpthread
linkerOpts.mingw = -lole32
linkerOpts.android = -lm -ldl

# System frameworks the embedded highgui/videoio backends reference. The
# platform key matches KonanTarget.Family (OSX, IOS, TVOS, WATCHOS, LINUX,
# MINGW, ANDROID); Kotlin/Native forwards the matching key's arguments from
# the cinterop klib manifest into every consumer's link command, so
# library users only import - no extra linker configuration needed.
linkerOpts.osx = -framework Cocoa -framework AppKit -framework AVFoundation -framework CoreMedia -framework CoreVideo -framework QuartzCore
linkerOpts.ios = -framework Foundation -framework CoreFoundation -framework UIKit -framework ImageIO -framework CoreGraphics -framework QuartzCore
linkerOpts.tvos = -framework Foundation -framework CoreFoundation -framework UIKit -framework ImageIO -framework CoreGraphics -framework QuartzCore
linkerOpts.watchos = -framework Foundation -framework CoreFoundation -framework ImageIO -framework CoreGraphics -framework QuartzCore
